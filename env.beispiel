# Kopieren nach ".env" und ausfüllen. Die Datei .env NIE ins Git-Repository hochladen.
ANTHROPIC_API_KEY=sk-ant-...
# Code, den die Lernenden eingeben müssen (leer lassen = kein Code)
KLASSEN_CODE=wasser7b
# KI-Anfragen pro Gerät und Stunde
LIMIT_PRO_STUNDE=60
# Obergrenze pro IP-Adresse (ganzes Schulnetz) und Stunde
LIMIT_PRO_IP_STUNDE=1500
# Freigegebene Modelle, das erste ist der Standard für Lernende (günstig zuerst ist sinnvoll)
MODELLE=claude-haiku-5-5,claude-sonnet-5-5,claude-opus-5-5
# Nur für docker-compose.https.yml: Domain, die auf diesen Rechner zeigt
DOMAIN=lernen.meine-schule.ch
